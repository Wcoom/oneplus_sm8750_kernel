gawk.csh
gawk.sh
[/etc/profile.d/*.sh 里的 PATH]
/etc/profile.d/gawk.sh:2:	unset AWKPATH
/etc/profile.d/gawk.sh:3:	export AWKPATH=`gawk 'BEGIN {print ENVIRON["AWKPATH"]}'`
/etc/profile.d/gawk.sh:7:	[ -z "$AWKPATH" ] && AWKPATH=`gawk 'BEGIN {print ENVIRON["AWKPATH"]}'`
/etc/profile.d/gawk.sh:8:	export AWKPATH="$*:$AWKPATH"
/etc/profile.d/gawk.sh:12:	[ -z "$AWKPATH" ] && AWKPATH=`gawk 'BEGIN {print ENVIRON["AWKPATH"]}'`
/etc/profile.d/gawk.sh:13:	export AWKPATH="$AWKPATH:$*"
/etc/profile.d/gawk.sh:17:	unset AWKLIBPATH
/etc/profile.d/gawk.sh:18:	export AWKLIBPATH=`gawk 'BEGIN {print ENVIRON["AWKLIBPATH"]}'`
/etc/profile.d/gawk.sh:22:	[ -z "$AWKLIBPATH" ] && \
/etc/profile.d/gawk.sh:23:		AWKLIBPATH=`gawk 'BEGIN {print ENVIRON["AWKLIBPATH"]}'`

